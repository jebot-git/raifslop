; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ultimate Boomer Simulator"
config/version="0.1.19-rc.1"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Real AI Fishing"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.063, 0.122, 0.133, 1)
boot_splash/image="res://assets/ui/store_logo.png"
config/icon="res://assets/icon.svg"
config/custom_user_dir_name.linux="godot/app_userdata/Real AI Fishing"
run/main_scene.quest_xr="res://scenes/quest_bootstrap.tscn"

[audio]

driver/enable_input=true

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/fishing_export/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/vrm/plugin.cfg")

[physics]

common/physics_ticks_per_second=90

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking_controller_data_source=true
openxr/extensions/eye_gaze_interaction=true
shaders/enabled=true
openxr/extensions/meta/body_tracking=true
openxr/extensions/meta/face_tracking=true
openxr/extensions/automatically_request_runtime_permissions=false

[importer_defaults]

texture={
"mipmaps/generate": true
}
