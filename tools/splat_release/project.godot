config_version=5
[application]
config/name="Real AI Fishing — Splat Testing"
config/version="0.1.0-splat.1"
config/use_custom_user_dir=true
config/custom_user_dir_name="RealAIFishing-SplatTesting"
config/icon="res://assets/icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
[audio]
driver/enable_input=false
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0
[editor_plugins]
enabled=PackedStringArray("res://addons/gdgs/plugin.cfg")
[gdgs]
rendering/backend="Raster"
[physics]
common/physics_ticks_per_second=90
[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
[xr]
openxr/enabled=true
openxr/extensions/hand_tracking=false
openxr/extensions/automatically_request_runtime_permissions=false
shaders/enabled=true
